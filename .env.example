# Required. The app refuses to start without it — there is no default.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_generated_secret

# Only needed to re-download the training datasets from the notebooks.
ROBOFLOW_API_KEY=replace_with_your_roboflow_key

GEMINI_API_KEY=replace_with_your_key_here
MODEL_NAME=gemma-4-31b-it
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=your_email@gmail.com
